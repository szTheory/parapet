{
  "$comment": "Parapet design tokens — machine-readable mirror of tokens.css. Source: prompts/parapet-brand-identity-deep-research.md. Values copied verbatim, not re-derived. v1.5.",
  "color": {
    "neutral": {
      "parapet-black": "#101820",
      "deep-slate": "#18232B",
      "wall-slate": "#2E3A42",
      "stone": "#D8D0C3",
      "mortar": "#EAE2D4",
      "limestone": "#F8F4EC"
    },
    "signal": {
      "watch-blue": "#256C82",
      "beacon-amber": "#B45309",
      "beacon-amber-light": "#D97706",
      "budget-moss": "#567236",
      "incident-red": "#B13A32",
      "trace-violet": "#6D5BD0"
    },
    "status": {
      "healthy":   { "text": "#3F5E28", "bg": "#EFF6E8", "border": "#B6C99A" },
      "watch":     { "text": "#92400E", "bg": "#F8EFD7", "border": "#E3B66E" },
      "burning":   { "text": "#9F2D2D", "bg": "#FCE8E2", "border": "#E3A19A" },
      "exhausted": { "text": "#7F1D1D", "bg": "#F8D7D4", "border": "#C87670" },
      "unknown":   { "text": "#2E3A42", "bg": "#ECEFF1", "border": "#CBD2D8" },
      "ai-assist": { "text": "#4F46A5", "bg": "#ECEBFF", "border": "#B9B5F6" }
    },
    "semantic": {
      "light": { "bg": "#F8F4EC", "surface": "#FFFFFF", "surface-soft": "#EAE2D4", "text": "#101820", "text-muted": "#2E3A42", "link": "#256C82", "border": "rgba(16,24,32,0.12)" },
      "dark":  { "bg": "#18232B", "surface": "#2E3A42", "text": "#F8F4EC", "text-muted": "#D8D0C3", "link": "#6FA8BC", "border": "rgba(248,244,236,0.16)", "$note": "link is a lightened Watch Blue for WCAG AA on Deep Slate; #256C82 is only ~2.7:1 on dark" }
    }
  },
  "font": {
    "sans": "\"IBM Plex Sans\", Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
    "serif": "\"IBM Plex Serif\", Georgia, serif",
    "$logo": "Wordmark is Space Grotesk shipped as OUTLINED PATHS (font-independent). Not a UI typeface."
  },
  "type-scale": {
    "display":   { "size": 56, "line": 1.00, "weight": 500 },
    "h1":        { "size": 40, "line": 1.08, "weight": 500 },
    "h2":        { "size": 30, "line": 1.16, "weight": 500 },
    "h3":        { "size": 22, "line": 1.25, "weight": 500 },
    "body":      { "size": 16, "line": 1.60, "weight": 400 },
    "body-sm":   { "size": 14, "line": 1.50, "weight": 400 },
    "caption":   { "size": 12, "line": 1.40, "weight": 500 },
    "code":      { "size": 13, "line": 1.55, "weight": 400 },
    "metric-lg": { "size": 36, "line": 1.00, "weight": 500 },
    "metric-sm": { "size": 20, "line": 1.10, "weight": 500 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "radius": { "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 999 },
  "border": {
    "light": "1px solid rgba(16,24,32,0.12)",
    "dark": "1px solid rgba(248,244,236,0.16)"
  },
  "shadow": {
    "card": "0 1px 2px rgba(16,24,32,0.06)",
    "popover": "0 12px 32px rgba(16,24,32,0.16)"
  },
  "focus": {
    "ring": "2px solid #256C82",
    "ring-on-dark": "2px solid #F8F4EC",
    "offset": 2
  },
  "motion": { "fast": 120, "base": 200, "ease": "cubic-bezier(0.2,0,0,1)" }
}
