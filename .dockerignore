# Docker build context lives at the repo root (examples/demo_app/docker-compose.yml
# uses `context: ../../`). Keeping this lean shrinks the context transfer from
# hundreds of MB to tens and stops unrelated file churn from busting the layer cache.
#
# KEEP (the prod Dockerfile needs these): mix.exs, mix.lock, lib/, priv/, config/,
# assets/, and the same under examples/demo_app/. Everything below is build output,
# VCS, planning, or docs that never belong in the image context.

# --- Elixir build artifacts & deps (regenerated inside the image) ---
_build/
deps/
.mix/
*.ez
erl_crash.dump
examples/*/_build/
examples/*/deps/

# --- Node / asset build outputs (assets.deploy regenerates them) ---
**/node_modules/
priv/static/assets/
examples/*/priv/static/assets/
examples/*/priv/static/cache_manifest.json

# --- Version control & CI ---
.git/
.gitignore
.gitattributes
.github/

# --- GSD planning + generated docs (never needed in the image) ---
.planning/
doc/
docs/
brandbook/
bench/
prompts/

# --- Tests (not needed for the runtime image) ---
test/
examples/*/test/

# --- Local/editor/OS cruft ---
.elixir_ls/
.dialyzer_plt
tmp/
cover/
coverage/
.DS_Store
*.log
.env
.env.*.local
.docker/
