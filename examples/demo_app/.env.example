# Docker Compose overrides for fixed-port mode.
# Copy this to .env for local overrides. `make up-auto` writes generated
# conflict-free settings to .docker/auto.env instead.

COMPOSE_PROJECT_NAME=parapet_demo
WEB_PORT=4000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=parapet
# DB_PORT is only used with docker-compose.db-port.yml or `make up-db-port`.
DB_PORT=5432
