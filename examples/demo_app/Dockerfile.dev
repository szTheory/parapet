FROM elixir:1.15-slim

RUN apt-get update && apt-get install -y build-essential git inotify-tools \
    && apt-get clean && rm -f /var/lib/apt/lists/*_*

WORKDIR /app

RUN mix local.hex --force && \
    mix local.rebar --force

# We don't need to COPY the code here because docker-compose mounts it as a volume.
# But we need a startup script to fetch deps and start the server so that the container
# dynamically handles the mounted code.

WORKDIR /app/examples/demo_app

# The startup script will fetch deps, run migrations, and start Phoenix
COPY examples/demo_app/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]
