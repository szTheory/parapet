defmodule <%= inspect(@module_prefix) %>.<%= @name_camelized %> do
  use Parapet.Recovery

  @moduledoc """
  Host recovery capability: <%= @name_camelized %>.

  This module was generated by `mix parapet.gen.recovery`. Customize each callback
  to implement your recovery action:

  1. Update `id/0` to return one of the 5 allowlisted capability atoms.
  2. Update `label/0` with a short human-readable label shown in the Operator UI.
  3. Implement `preview/2` to return a map describing what the action will do.
  4. Implement `execute/2` to perform the mutation and return the outcome.

  Register this capability in your application start:

      Parapet.Recovery.attach([<%= inspect(@module_prefix) %>.<%= @name_camelized %>])

  See the [Recovery Actions Guide](https://hexdocs.pm/parapet/recovery-actions.html)
  for full authoring instructions and examples.
  """

  @doc """
  The capability atom identifying this recovery action.

  IMPORTANT: must be one of the 5 allowlisted atoms:
    - :retry_async_item
    - :requeue_dead_letter
    - :request_manual_provider_check
    - :revert_feature_flag
    - :disable_metric_label

  Replace :<%= @name_underscored %> with the appropriate atom from the list above.
  Parapet.Capabilities.register_recovery/2 will raise ArgumentError for any other atom.
  """
  def id, do: :<%= @name_underscored %>

  @doc """
  Human-readable label displayed in the Operator UI for this capability.
  """
  def label, do: "<%= @name_camelized %>"

  @doc """
  Returns a preview map describing what `execute/2` will do.

  The returned map should include:
    - `:count` — number of items targeted
    - `:target_refs` — list of item identifiers that will be acted on
    - `:preconditions` — list of conditions that must hold before executing
    - `:warnings` — list of human-readable caution strings
    - `:summary` — one-line description of the action

  Return `{:ok, preview_map}` or `{:error, reason}` if the preview cannot be computed.
  """
  def preview(_incident, _step), do: {:ok, %{}}

  @doc """
  Performs the recovery mutation and returns the outcome.

  `incident` is the incident map from the Operator UI context.
  `target_refs` is the list of item identifiers from the confirmed preview.

  Return `{:ok, result_map}` on success or `{:error, reason}` on failure.
  The result map is stored in the audit trail.
  """
  def execute(_incident, _target_refs), do: {:ok, %{}}
end
