{<<"name">>,<<"flop_phoenix">>}.
{<<"version">>,<<"0.26.0">>}.
{<<"description">>,
 <<"Phoenix components for pagination, sortable tables and filter forms using Flop.">>}.
{<<"elixir">>,<<"~> 1.14">>}.
{<<"app">>,<<"flop_phoenix">>}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"files">>,
 [<<"lib">>,<<"lib/flop_phoenix">>,<<"lib/flop_phoenix/misc.ex">>,
  <<"lib/flop_phoenix/pagination.ex">>,<<"lib/flop_phoenix/table.ex">>,
  <<"lib/flop_phoenix/errors.ex">>,<<"lib/flop_phoenix/form_data.ex">>,
  <<"lib/flop_phoenix.ex">>,<<".formatter.exs">>,<<"mix.exs">>,
  <<"CHANGELOG.md">>,<<"README.md">>,<<"LICENSE">>]}.
