 [[{<<"name">>,<<"flop">>},
   {<<"app">>,<<"flop">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<">= 0.23.0 and < 0.27.0">>},
   {<<"repository">>,<<"hexpm">>}],
