   {<<"app">>,<<"phoenix_html">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 4.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"phoenix_live_view">>},
   {<<"app">>,<<"phoenix_live_view">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 1.0.6 or ~> 1.1.0">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"build_tools">>,[<<"mix">>]}.
